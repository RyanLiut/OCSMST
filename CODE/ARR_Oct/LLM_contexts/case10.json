{
  "流畅综合": {
    "撞击": "\"撞击\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"用手或器具撞击物体\"。以下是体现该功能的一些例句：打门；打鼓。",
    "从事": "\"从事\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"a)表示从事的工作；b)发生与人交涉的行为；c)采取某种方式；d)表示身体上的某些动作或状态；e)表示做的游戏\"。以下是体现该功能的一些例句：打杂；打夜班；打游击；打埋伏；打前站；打赌；打官司；打交道；打官腔；打比喻；打比方；打马虎眼；打哈欠；打手势；打呼；打嗝儿；打踉跄；打球；打牌；打扑克；打秋千。",
    "射出": "\"射出\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"放射；发出\"。以下是体现该功能的一些例句：打雷；打炮；打信号；打电话。",
    "殴打": "\"殴打\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"殴打；攻打\"。以下是体现该功能的一些例句：不能打人；两个人打了起来；打架。",
    "编织": "\"编织\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"编织\"。以下是体现该功能的一些例句：打草鞋；打毛衣。",
    "揭凿": "\"揭凿\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"揭；凿开\"。以下是体现该功能的一些例句：打开盖子；打冰；打井；打眼儿。",
    "举提": "\"举提\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"举；提\"。以下是体现该功能的一些例句：打旗子；打灯笼；打伞；打起精神来。",
    "计算": "\"计算\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"定出；计算\"。以下是体现该功能的一些例句：打草稿；打主意；成本打二百块钱。",
    "破碎": "\"破碎\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"器皿、蛋类等因撞击而破碎\"。以下是体现该功能的一些例句：碗打了；鸡飞蛋打。",
    "制造": "\"制造\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"制造（器物、食品）\"。以下是体现该功能的一些例句：打刀；打家具；打烧饼。",
    "涂写": "\"涂写\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"涂抹；画；印\"。以下是体现该功能的一些例句：打蜡；打问号；打墨线；打格子；打戳子。",
    "购买": "\"购买\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"买\"。以下是体现该功能的一些例句：打油；打酒；打车票。",
    "舀取": "\"舀取\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"舀取\"。以下是体现该功能的一些例句：打水；打粥。",
    "搅拌": "\"搅拌\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"搅拌\"。以下是体现该功能的一些例句：打馅儿；打糨子。",
    "捆": "\"捆\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"捆\"。以下是体现该功能的一些例句：打包裹；打铺盖卷儿；打裹腿。",
    "捕捉": "\"捕捉\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"捕捉、猎取（禽兽等）\"。以下是体现该功能的一些例句：打鱼；打狼。",
    "去除": "\"去除\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"去除\"。以下是体现该功能的一些例句：打旁杈；打胎；打皮；叶子已经打过了。",
    "收集": "\"收集\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"用割、砍等动作来收集\"。以下是体现该功能的一些例句：打柴；打草。",
    "修建": "\"修建\"是汉语泛义动词\"打\"的跨语言及方言共通的功能，它的基本含义是\"建造；修筑\"。以下是体现该功能的一些例句：打坝；打墙。"
  },
